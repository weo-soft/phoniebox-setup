# =============================================================================
# .env-example — Template for the setup script configuration (.env)
# =============================================================================
# Copy this file to .env and adjust the values:
#     cp .env-example .env
#     chmod 600 .env
#
# The real .env holds the script's own settings: the SSH connection to the
# Raspberry Pi (IP/host, user, password) and — optionally — the GitHub source
# URL used for the installation.
#
# SECURITY: .env contains credentials and is NEVER uploaded to the Pi.
# Only the application config (phoniebox.config) is transferred to the
# installer. .env is listed in .gitignore and must never be committed.
# Prefer storing the password in .env instead of passing it on the command
# line (command line arguments are visible in the process list).
#
# Command line arguments override the values in .env.

# IP address or hostname of the Raspberry Pi
PI_HOST=192.168.1.50

# SSH user and password on the Pi (quote values containing special characters)
SSH_USER=pi
SSH_PASSWORD=change-me

# Optional: GitHub source URL (repository/branch) used for the installation.
# Overrides GIT_USER/GIT_BRANCH from the application config
# (phoniebox.config). Example:
# SOURCE_URL=https://github.com/weo-soft/RPi-Jukebox-RFID/tree/future3/feature/installer-noninteractive-config

# Optional: path to the application config (default: phoniebox.config
# next to the script). Relative paths are resolved against this file's directory.
# APP_CONFIG=/home/user/phoniebox.config

# Optional: reboot the Pi after a successful installation (true/false)
# REBOOT=false

# Optional: verify the SSH host key against ~/.ssh/known_hosts (true/false).
#   false (default): the host key is NOT verified — a differing fingerprint
#     in known_hosts is ignored and never blocks the connection. Reliable for
#     reimaged Pis, but offers no protection against man-in-the-middle attacks.
#   true: verify with accept-new — an unknown host is added automatically
#     (no prompt), but a CHANGED key aborts the installation. Fix:
#     ssh-keygen -R <IP>
# VERIFY_HOST_KEY=false

# Optional: show the detailed installation log (~/INSTALL-<timestamp>.log)
# LIVE while the installation runs (true/false). A parallel SSH session tails
# the log file on the Pi until the installation finishes.
# SHOW_LOG=false
